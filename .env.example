# Copy to .env.local and fill in. Never commit real values.

# --- Database (optional) ---------------------------------------------------
# Leave both blank to run on the local demo store (.data/seedflow.json).
# The service role key is used ONLY on the server; it is never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff access ----------------------------------------------------------
# Shared staff key. Required for any deployed instance: without it a
# production build is read-only and hides requester contact details.
# Staff enter it once on the Settings page.
SEEDFLOW_ADMIN_KEY=

# Allow changes without a key on a production build (local `next start` only).
# SEEDFLOW_ALLOW_UNAUTHENTICATED_WRITES=true

# Disable the "Reset demo data" button (recommended once real data is in Supabase).
# SEEDFLOW_DISABLE_DEMO_RESET=true

# Override where the local demo store keeps its file.
# SEEDFLOW_DATA_FILE=

# --- Cognito Forms (future) ------------------------------------------------
# Live API sync is NOT implemented until Cognito's API format is verified.
COGNITO_API_KEY=
COGNITO_FORM_ID=
# Enables POST /api/integrations/cognito/webhook (secret required on every call).
COGNITO_WEBHOOK_SECRET=
# JSON mapping of SeedFlow field -> Cognito field name for webhook payloads.
# COGNITO_FIELD_MAPPING={"external_entry_id":"Id","requester_name":"YourName","organization_name":"School","requested_seeds":"SeedTypes"}
