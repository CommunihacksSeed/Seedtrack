# Copy to .env.local and fill in. Never commit real values.
# In production, set these as Cloudflare Worker secrets instead.
# The database is the D1 binding `DB`, not an environment variable.

# Disable the "Reset demo data" button. Keep this on for any public deployment.
# SEEDFLOW_DISABLE_DEMO_RESET=true

# --- Notifications (optional) --------------------------------------------
# Notifications are turned on in Settings → Notifications. Without these two
# values they're only written to the notification log (nothing is emailed).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# Public URL of this app, used for links in staff emails (https://seedflow.space in production)
APP_URL=

# --- Cognito Forms (future) ------------------------------------------------
# Live API sync is NOT implemented until Cognito's API format is verified.
COGNITO_API_KEY=
COGNITO_FORM_ID=
# Enables POST /api/integrations/cognito/webhook (secret required on every call).
COGNITO_WEBHOOK_SECRET=
# JSON mapping of SeedFlow field -> Cognito field name for webhook payloads.
# COGNITO_FIELD_MAPPING={"external_entry_id":"Id","requester_name":"YourName","organization_name":"School","requested_seeds":"SeedTypes"}
